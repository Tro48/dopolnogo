# Скопируйте в .env.local и заполните. .env.local в git не попадает.
# Всё, что не начинается с NEXT_PUBLIC_, доступно только на сервере.

# Публичный адрес сайта — нужен для метаданных, OG и sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Имя бота без @ — для кнопки «Открыть в Telegram» и Login Widget админки
NEXT_PUBLIC_BOT_USERNAME=""

# Supabase: orders и profiles закрыты RLS, запись только через service role
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role: запись заявок и переходы статусов. Никогда в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram. Токен бота — секрет: им подписывается initData, по нему же
# проверяется подлинность пользователя Mini App.
TELEGRAM_BOT_TOKEN=""
# Секрет вебхука: приходит в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без него эндпоинт вебхука открыт всему интернету.
TELEGRAM_WEBHOOK_SECRET=""

# Ключ подписи cookie-сессии. Минимум 32 байта.
# Сгенерировать: openssl rand -base64 32
SESSION_SECRET=""

# Upstash Redis: rate limit на создание заявок и на вебхук
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Яндекс.Метрика на лендинге: номер счётчика
NEXT_PUBLIC_YM_ID=""
