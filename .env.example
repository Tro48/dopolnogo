# Скопируйте в .env.local и заполните. .env.local в git не попадает.
# Всё, что не начинается с NEXT_PUBLIC_, доступно только на сервере.

# Публичный адрес сайта — нужен для метаданных, OG и sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase: таблицы cases (публичное чтение) и briefs (только service role)
NEXT_PUBLIC_SUPABASE_URL=""
# Anon-ключ: чтение опубликованных кейсов под RLS-политикой
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service role: запись брифов из Route Handler. Никогда в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram: уведомление о новом брифе (модуль переиспользуется из kuznya-barbershop)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Upstash Redis: rate limit на /api/brief
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Яндекс.Метрика: номер счётчика
NEXT_PUBLIC_YM_ID=""
